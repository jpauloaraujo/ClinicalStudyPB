# Variáveis dos testes E2E (Playwright). Copie para .env.e2e (ignorado pelo Git) e ajuste.
# Todos os valores abaixo são fictícios e valem só para o ambiente de teste.

# Onde a aplicação web e a API estão rodando
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8081

# Administrador existente (seed V2 do Flyway), usado só para criar/atualizar os usuários E2E
E2E_BOOTSTRAP_EMAIL=admin@clinicalstudy.test
E2E_BOOTSTRAP_SENHA=senha-de-teste

# Usuários dedicados aos testes E2E, criados pelo setup (um por perfil que entra na web)
E2E_ADMINISTRADOR_EMAIL=e2e.administrador@clinicalstudy.test
E2E_ADMINISTRADOR_SENHA=senha-e2e-administrador
E2E_PESQUISADOR_EMAIL=e2e.pesquisador@clinicalstudy.test
E2E_PESQUISADOR_SENHA=senha-e2e-pesquisador
E2E_COORDENADOR_EMAIL=e2e.coordenador@clinicalstudy.test
E2E_COORDENADOR_SENHA=senha-e2e-coordenador
