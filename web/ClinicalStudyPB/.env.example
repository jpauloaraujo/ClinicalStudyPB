# Copie para .env.local (ignorado pelo Git) para mudar a URL da API.
# Padrão quando não definido: http://localhost:8081
VITE_API_URL=http://localhost:8081

# "true" liga o Mock Service Worker: a web usa dados fictícios, sem backend (veja o README, seção "Mocks").
# Fica desligado por padrão; com ele desligado as mesmas chamadas vão para o backend real.
# Para entrar com um perfil no mock use e-mails que começam com admin, pesquisador ou coordenador e qualquer senha.
VITE_USE_MOCKS=false
