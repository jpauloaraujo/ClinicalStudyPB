# T67: variáveis opcionais do docker-compose.yml. Copie para .env (ignorado pelo Git) só se quiser mudar algo.
# Todos os valores são fictícios; sem o arquivo .env, o compose usa exatamente estes padrões.

DB_USERNAME=postgres
DB_PASSWORD=postgres
# Porta do PostgreSQL no host (dentro da rede do compose é sempre 5432)
DB_PORT=5433

# Segredo HS256 do JWT: mínimo de 32 caracteres
JWT_SECRET=segredo-ficticio-do-docker-compose-com-mais-de-256-bits-0123456789

# demo: migrations + dados fictícios de demonstração (T63) · prod: só as migrations
SPRING_PROFILES_ACTIVE=demo

# Se mudar a porta da web ou da API no host, ajuste as duas linhas abaixo e rode "docker compose up --build"
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8082
VITE_API_URL=http://localhost:8081
